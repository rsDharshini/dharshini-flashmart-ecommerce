# =============================================================================
# .gitignore - Files that should NOT go to GitHub
# =============================================================================

# Terraform state files (contains sensitive data!)
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Terraform vars (contains your AWS URLs and secrets)
terraform.tfvars

# Lambda zip files (auto-generated by Terraform)
lambda_code/zips/

# Frontend build output (auto-generated)
flashmart-frontend/dist/
flashmart-frontend/node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Environment files
.env
.env.local